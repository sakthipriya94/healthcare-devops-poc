# Copy to .env (git-ignored) and change every value:  cp .env.example .env
# Generate strong values with:  openssl rand -base64 32 | tr -d '/+='

# --- Django ---
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Local development only: allows `curl -H "X-Tenant-ID: hospital_a"`. NEVER true in AWS.
ALLOW_TENANT_HEADER=true
SEED_DEMO_DATA=true

# --- Local PostgreSQL container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin-password

# --- Per-tenant database credentials (one database + one role per tenant) ---
HOSPITAL_A_DB_PASSWORD=change-me-a
HOSPITAL_B_DB_PASSWORD=change-me-b
