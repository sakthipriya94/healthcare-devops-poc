# Non-secret, environment-specific settings. Secrets are generated by Terraform
# and stored in AWS Secrets Manager - they never appear in this file.
environment       = "dev"
aws_region        = "ap-south-1"
github_repository = "sakthipriya94/healthcare-devops-poc"

manage_ecr = false # the healthcare-backend/frontend/nginx ECR repositories already exist (created outside Terraform); set true only on a fresh account

# Cost-minimal sizing
instance_type            = "t3.small"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_multi_az              = false
db_backup_retention_days = 7
protect_data             = false

# Optional: set after you own a domain + ACM certificate
# domain_name     = "dev.example.com"
# route53_zone_id = "Z123456789"
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/..."
# alert_email     = "you@example.com"
